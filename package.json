{
  "name": "aegis-rtq-command-deck",
  "version": "1.0.0",
  "private": true,
  "bin": "dist/rtq-sea.js",
  "description": "AEGIS — an interactive command deck that demonstrates the true power of RTQ, the Risk-Adaptive Capability Security Runtime.",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n rtq,deck -c cyan,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "build:sea": "node scripts/build-standalone.mjs",
    "build:pkg": "npm run build:sea && npx pkg .",
    "build:dmg": "create-dmg \"dist/pkg/rtq-demo-macos\" \"dist/rtq-demo.dmg\" --overwrite",
    "build:appimage": "bash ./scripts/build-appimage.sh",
    "release:assets": "gh release upload v1.0.0 dist/rtq-demo.dmg dist/pkg/rtq-demo-win.exe dist/rtq-demo.AppImage"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pkg": "^5.8.1"
  },
  "optionalDependencies": {
    "create-dmg": "^1.3.0"
  },
  "pkg": {
    "scripts": ["dist/rtq-sea.js"],
    "assets": ["web/dist/**/*", "server/workspace/**/*"],
    "targets": ["node18-macos-x64", "node18-win-x64", "node18-linux-x64"],
    "outputPath": "dist/pkg"
  },
  "engines": {
    "node": "\u003e=20"
  }
}
